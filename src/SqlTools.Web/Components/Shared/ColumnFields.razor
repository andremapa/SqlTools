<div class="row g-2 mb-2">
    <div class="col-sm-5">
        <label class="form-label">Coluna</label>
        @if (Lookup)
        {
            <ColumnNameInput Value="@Column.Name" ValueChanged="OnNameChanged" Schema="@Schema" Table="@Table" Placeholder="Escolha ou digite" />
        }
        else
        {
            <input class="form-control" @bind="Column.Name" @bind:event="oninput" placeholder="Ex.: Email" />
        }
    </div>
    <div class="col-sm-4">
        <label class="form-label">Tipo</label>
        <TypeSelect Column="Column" />
    </div>
    <div class="col-sm-3">
        <label class="form-label">Tamanho</label>
        <TypeArgsFields Column="Column" />
    </div>
</div>

<label class="form-check mb-2">
    <input type="checkbox" class="form-check-input" @bind="Column.IsNullable" />
    Aceita NULL
</label>

@if (ShowIdentity)
{
    <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <label class="form-check mb-0">
            <input type="checkbox" class="form-check-input" @bind="Column.IsIdentity" />
            IDENTITY
        </label>
        @if (Column.IsIdentity)
        {
            <div class="input-group input-group-sm w-auto">
                <span class="input-group-text">Início</span>
                <input type="number" class="form-control narrow" @bind="Column.IdentitySeed" />
                <span class="input-group-text">Incremento</span>
                <input type="number" class="form-control narrow" @bind="Column.IdentityIncrement" />
            </div>
        }
    </div>
}

@if (ShowDefault)
{
    <div class="row g-2">
        <div class="col-sm-6">
            <label class="form-label">Valor padrão (expressão SQL)</label>
            <input class="form-control font-monospace" @bind="Column.DefaultExpression" @bind:event="oninput"
                   placeholder="Ex.: 0, GETDATE(), N'Ativo'" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Nome da constraint default</label>
            <input class="form-control" @bind="Column.DefaultConstraintName" @bind:event="oninput"
                   placeholder="@(string.IsNullOrWhiteSpace(Column.Name) ? "DF_Tabela_Coluna" : $"DF_{Table}_{Column.Name}")" />
        </div>
    </div>
}

@code {
    [Inject] private DatabaseConnection Connection { get; set; } = default!;

    [Parameter, EditorRequired] public ColumnDefinition Column { get; set; } = default!;
    [Parameter] public string Table { get; set; } = "";
    [Parameter] public string Schema { get; set; } = "dbo";
    [Parameter] public bool ShowIdentity { get; set; } = true;
    [Parameter] public bool ShowDefault { get; set; } = true;

    /// <summary>A coluna já existe: sugere as colunas da tabela e preenche tipo/nulidade ao escolher uma.</summary>
    [Parameter] public bool Lookup { get; set; }

    private async Task OnNameChanged(string name)
    {
        Column.Name = name;

        // As colunas da tabela são lidas sob demanda: garante que já chegaram antes de procurar o tipo.
        await Connection.EnsureTableAsync(Schema, Table);

        var existing = Connection.Find(Schema, Table)?.Columns
            .FirstOrDefault(c => c.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase));
        if (existing is null || SqlTypeCatalog.Find(existing.DataType) is not { } type)
            return;

        Column.Name = existing.Name;
        Column.DataType = type.Name;
        Column.IsNullable = existing.IsNullable;
        switch (type.ArgumentKind)
        {
            case TypeArgumentKind.Length:
                Column.Length = CharLength(existing, type);
                break;
            case TypeArgumentKind.LengthOrMax:
                Column.IsMax = existing.MaxLength == -1;
                Column.Length = existing.MaxLength == -1 ? null : CharLength(existing, type);
                break;
            case TypeArgumentKind.PrecisionScale:
                Column.Precision = existing.Precision;
                Column.Scale = existing.Scale;
                break;
            case TypeArgumentKind.FractionalSeconds:
                Column.FractionalSeconds = existing.Scale;
                break;
        }
    }

    // max_length é em bytes: tipos Unicode (NCHAR/NVARCHAR) ocupam 2 bytes por caractere.
    private static int CharLength(ColumnInfo column, SqlTypeInfo type) =>
        type.Name.StartsWith('N') ? column.MaxLength / 2 : column.MaxLength;
}
