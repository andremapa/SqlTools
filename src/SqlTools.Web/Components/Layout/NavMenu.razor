@implements IDisposable
@using System.Text.Json
@inject ScriptSession Session
@inject DatabaseConnection Connection
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand brand" href="">
            <Icon Name="tool" Size="1.35rem" />
            <span>SqlTools</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Menu de navegação" class="navbar-toggler" />

@* Clicar em um link fecha o menu no celular; clicar no cabeçalho de um grupo (recolher/expandir) não. *@
<div class="nav-scrollable" onclick="if (!event.target.closest('.nav-group-toggle')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column nav-main pt-2">
        <AuthorizeView Roles="@UserAdminService.AdminRole">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@NavItems.Admin.Items[0].Href"><Icon Name="@NavItems.Admin.Icon" />@NavItems.Admin.Title</NavLink>
            </div>
        </AuthorizeView>

        @foreach (var group in NavItems.Menu)
        {
            @if (group.IsSingleLink)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@group.Items[0].Href">
                        <Icon Name="@group.Icon" />@group.Title
                        @if (group == NavItems.Batch && Session.Batch.Count > 0)
                        {
                            <span class="badge rounded-pill nav-badge ms-auto">@Session.Batch.Count</span>
                        }
                        else if (group == NavItems.Connection && Connection.IsConnected)
                        {
                            <span class="status-dot ms-auto" title="Conectado a @Connection.Schema!.Database"></span>
                        }
                    </NavLink>
                </div>
            }
            else
            {
                var open = _open.Contains(group.Title);
                <div class="nav-group @(HasActive(group) ? "has-active" : null)">
                    <div class="px-3">
                        <button type="button" class="nav-group-toggle" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleAsync(group)">
                            <Icon Name="@group.Icon" />
                            <span>@group.Title</span>
                            <span class="nav-count">@group.Items.Count</span>
                            <span class="chev @(open ? "open" : null)"><Icon Name="chevron" Size="0.9rem" /></span>
                        </button>
                    </div>

                    @if (open)
                    {
                        <div class="nav-sub">
                            @foreach (var item in group.Items)
                            {
                                <div class="nav-item px-3">
                                    <NavLink class="nav-link" href="@item.Href"><Icon Name="@item.Icon" />@item.Title</NavLink>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </nav>
</div>

@code {
    private const string StorageKey = "sqltools.nav.open";

    // Grupos abertos. Por padrão só o da página atual; o que o usuário abrir/fechar fica lembrado no navegador.
    private readonly HashSet<string> _open = new(StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Connection.Changed += OnChanged;
        Navigation.LocationChanged += OnLocationChanged;
        OpenActiveGroup();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var json = await JS.InvokeAsync<string?>("sqlTools.getItem", StorageKey);
            if (!string.IsNullOrEmpty(json) && JsonSerializer.Deserialize<string[]>(json) is { } saved)
            {
                _open.Clear();
                foreach (var title in saved)
                    _open.Add(title);
                OpenActiveGroup(); // a página atual sempre fica visível
                StateHasChanged();
            }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or JsonException)
        {
            // Sem localStorage (ou valor inválido): segue com o padrão.
        }
    }

    private async Task ToggleAsync(NavGroup group)
    {
        if (!_open.Remove(group.Title))
            _open.Add(group.Title);
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sqlTools.setItem", StorageKey, JsonSerializer.Serialize(_open));
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
        }
    }

    private string CurrentPath()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = path.IndexOfAny(['?', '#']);
        return (end >= 0 ? path[..end] : path).Trim('/');
    }

    private bool HasActive(NavGroup group) =>
        group.Items.Any(i => CurrentPath().Equals(i.Href, StringComparison.OrdinalIgnoreCase));

    private void OpenActiveGroup()
    {
        foreach (var group in NavItems.Menu.Where(g => !g.IsSingleLink && HasActive(g)))
            _open.Add(group.Title);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(async () =>
        {
            var before = _open.Count;
            OpenActiveGroup();
            if (_open.Count != before)
                await SaveAsync();
            StateHasChanged();
        });

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Connection.Changed -= OnChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
