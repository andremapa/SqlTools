@page "/perfil"
@implements IDisposable
@inject ProfileState Profile
@inject UserProfileService Profiles
@inject IJSRuntime JS

<PageTitle>Meu perfil · SqlTools</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Meu perfil</h1>
    <p class="text-muted mb-0">Seus dados de acesso e a foto que aparece no canto superior direito.</p>
</div>

@if (Profile.Current is { } user)
{
    <div class="card profile-card">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-4 align-items-center">
                <Avatar Name="@user.Name" PhotoUrl="@user.PhotoUrl" Size="7rem" />

                <div class="flex-grow-1">
                    <div class="h5 mb-0">@user.Name</div>
                    <div class="text-muted">@user.Email</div>
                    @if (!string.Equals(user.UserName, user.Email, StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="text-muted small">Usuário: @user.UserName</div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-3">
                        <label class="btn btn-primary mb-0 @(_busy ? "disabled" : null)">
                            <Icon Name="upload" Size="1rem" /> @(user.PhotoUrl is null ? "Escolher foto" : "Trocar foto")
                            <InputFile @ref="_input" OnChange="OnFileChosen" accept="image/png,image/jpeg,image/webp,image/gif" class="d-none" disabled="@_busy" />
                        </label>
                        @if (user.PhotoUrl is not null)
                        {
                            <button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="RemoveAsync">Remover foto</button>
                        }
                    </div>
                    <div class="form-text mt-2">
                        JPG, PNG, WebP ou GIF. A imagem é cortada em quadrado e reduzida no seu navegador antes de ser guardada.
                    </div>
                </div>
            </div>

            @if (_busy)
            {
                <div class="alert alert-info py-2 small mt-3 mb-0">Processando a imagem…</div>
            }
            @if (_message is not null)
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-success") py-2 small mt-3 mb-0">@_message</div>
            }
        </div>
    </div>
}

@code {
    private InputFile? _input;
    private bool _busy;
    private string? _message;
    private bool _isError;

    private sealed record ResizedImage(string? Data, string? Error);

    protected override async Task OnInitializedAsync()
    {
        Profile.Changed += OnProfileChanged;
        await Profile.LoadAsync();
    }

    private void OnProfileChanged() => InvokeAsync(StateHasChanged);

    private async Task OnFileChosen(InputFileChangeEventArgs _)
    {
        if (Profile.Current is not { } user || _input?.Element is not { } element)
            return;

        _busy = true;
        _message = null;
        try
        {
            // O navegador corta em quadrado, reduz e converte para JPEG: só um arquivo pequeno chega ao servidor.
            var resized = await JS.InvokeAsync<ResizedImage>("sqlTools.resizeImageFromInput", element, 256, UserProfileService.MaxPhotoBytes);
            if (resized.Data is null)
            {
                Show(resized.Error ?? "Não foi possível processar a imagem.", error: true);
                return;
            }

            var result = await Profiles.SavePhotoAsync(user.Id, Convert.FromBase64String(resized.Data));
            if (result.Ok)
            {
                await Profile.LoadAsync();
                Show("Foto atualizada.", error: false);
            }
            else
            {
                Show(result.Error!, error: true);
            }
        }
        catch (Exception ex) when (ex is JSException or FormatException)
        {
            Show("Não foi possível processar a imagem.", error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync()
    {
        if (Profile.Current is not { } user)
            return;

        _busy = true;
        try
        {
            await Profiles.RemovePhotoAsync(user.Id);
            await Profile.LoadAsync();
            Show("Foto removida.", error: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(string message, bool error)
    {
        _message = message;
        _isError = error;
    }

    public void Dispose() => Profile.Changed -= OnProfileChanged;
}
